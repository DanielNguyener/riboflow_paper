// Benchmark measurement layer. Applied to EVERY benchmark run via -c so that all
// scenarios are measured identically:
//
//   nextflow run main.nf -profile conda,default -params-file <p>.yaml \
//       -c benchmarks/benchmark.config -c benchmarks/fixed_resources.config
//
// This file changes MEASUREMENT and SCHEDULING determinism only. It deliberately
// does not touch errorStrategy: a retry changes what you are measuring, so instead
// `attempt` is captured in the trace below and aggregate.py invalidates any
// replicate containing attempt > 1 or a non-COMPLETED task.

// STAR sizing, applied uniformly to every scenario; the reference set's `_bench:`
// block normally supplies these and --star-cpus / --star-memory override. 48 GB
// covers a GRCh38 index (~27 GB resident) plus the coordinate sort.
//
// THIS selector is the one that governs. It and the STAR selectors in
// conf/default.config and fixed_resources.config all match STAR_ALIGN; among matching
// `withName` selectors Nextflow applies them in declaration order and the LAST one
// wins, and this block lands last in the merged config even though run_benchmark.sh
// passes fixed_resources.config after this file. Verified against the trace: the runs
// in results/gse269734 reserved 16 cpus / 48 GB per STAR task, which is this block,
// not fixed_resources.config's.
//
// Because that ordering is a Nextflow implementation detail rather than a guarantee,
// all three files are kept at the SAME values -- then the resolution order cannot
// silently change what is measured. If you edit one, edit all of them.
process {
    withName: 'STAR_ALIGN|STAR_ALIGN_RNASEQ|STAR_INDEX' {
        cpus   = (System.getenv('BENCH_STAR_CPUS')   ?: '16') as int
        memory = ((System.getenv('BENCH_STAR_MEMORY') ?: '48') as int) + '.GB'
    }
}

// Pin the executor to what the host actually has. conf/default.config advertises
// 16 cpus / 64.GB regardless of the machine; over-advertising lets Nextflow admit
// more concurrent work than there are cores, which inflates `realtime` and makes
// `%cpu` a measure of contention rather than of the tool. Both values are injected
// by run_benchmark.sh and recorded in host.json.
executor {
    cpus   = (System.getenv('BENCH_EXECUTOR_CPUS')   ?: '16' ) as int
    memory = (System.getenv('BENCH_EXECUTOR_MEMORY') ?: '64.GB')
}

// Default size for every process without an explicit withName entry -- ~118 of the
// 164 tasks in a full run, nearly all single-threaded shell steps (measured median
// peak RSS 13 MB, p95 528 MB). Clamped so the run cannot abort with "Process
// requirement exceeds available CPUs" on a small host.
process {
    cpus = Math.min(
        (System.getenv('BENCH_TASK_CPUS') ?: '1') as int,
        (System.getenv('BENCH_EXECUTOR_CPUS') ?: '16') as int)
    memory = ((System.getenv('BENCH_TASK_MEMORY') ?: '2') as int) + '.GB'
}

// Machine-readable trace: raw units (ms / bytes) instead of "1m 50s" / "1.2 GB".
// With raw = true the %cpu convention has varied across Nextflow versions, so
// aggregate.py calibrates the divisor against the run's own "CPU hours" footer
// rather than trusting it.
trace {
    enabled   = true
    raw       = true
    overwrite = true
    fields    = 'task_id,hash,process,tag,name,status,exit,attempt,submit,start,complete,duration,realtime,cpus,memory,%cpu,rss,peak_rss,vmem,peak_vmem,rchar,wchar,read_bytes,write_bytes,workdir'
}

report   { enabled = true; overwrite = true }
timeline { enabled = true; overwrite = true }
