// FIXED-RESOURCE LAYER for the benchmark. Layer it LAST:
//
//   nextflow run main.nf -profile conda,default -params-file <p>.yaml \
//       -c benchmarks/benchmark.config \
//       -c benchmarks/fixed_resources.config
//
// (run_benchmark.sh --extra-config fixed_resources.config does this.)
//
// WHAT "FIXED RESOURCES" MEANS
//   1. Every run receives the same total server allocation: 16 cores, 64 GB.
//   2. Every process requests the same process-specific resources in every
//      benchmark condition.
// It does NOT mean every process requests the whole server. Giving a one-core
// statistics or publishing step 16 cores and 64 GB would prevent any two independent
// tasks from overlapping, which measures the sum of serial task times rather than
// end-to-end performance on a fixed server. The values below are the ones
// conf/default.config ships, so the ribo and RNA-seq branches and the per-sample
// preprocessing steps overlap the way they normally do.
//
// WHY THIS FILE EXISTS
// benchmark.config's generic `process.cpus` / `process.memory` does NOT override a
// `withName:` selector -- Nextflow resolves the most specific matching selector
// regardless of load order (withName > withLabel > script directive > generic).
// conf/default.config declares selectors for cutadapt, all four bowtie2 paths, STAR,
// UMICOLLAPSE_DEDUP, the RIBOPY_* trio, a samtools/QC group and the
// STAR_TRANSCRIPTOME_DEDUP aliases, so they must be re-declared here -- by a file
// loaded later -- to take effect. Every selector conf/default.config declares is
// mirrored here, including the ones that do not run in this benchmark, so that this
// layer fully determines the resource configuration whatever profile sits underneath.
//
// The per-process values are HARDCODED, not read from --task-cpus / --task-memory:
// the methodological requirement is that they are identical in every condition, and a
// value that can differ between invocations cannot guarantee that. Only the
// lightweight default is environment-overridable, so the driver's startup concurrency
// estimate and host.json agree with what actually runs.
//
// Under the local executor `memory` is a scheduling reservation, not an enforced cap:
// it governs which tasks Nextflow admits concurrently. Reservations are sized from
// measured peak RSS (see each selector) so concurrent demand stays inside 64 GB:
//   STAR (48) + UMICOLLAPSE_DEDUP (8)    = 56  -> co-schedules, 8 GB spare
//   STAR (48) + RIBOPY_CREATE    (16)    = 64  -> co-schedules, exactly fits
//   STAR (48) + 8 lightweight tasks (16) = 64  -> co-schedules
//
// Keep this file and conf/default.config in step. A divergence means the benchmark
// has stopped measuring the profile that ships.

// Total server allocation. Held constant across every benchmark condition.
executor {
    cpus   = (System.getenv('BENCH_EXECUTOR_CPUS')   ?: '16') as int
    memory = (System.getenv('BENCH_EXECUTOR_MEMORY') ?: '64.GB')
}

process {
    executor = 'local'

    // Hard ceiling on any request, including nextflow.config's retry escalation.
    // Without it, UMICOLLAPSE_DEDUP's `{ 8.GB * task.attempt }` and RIBOPY_CREATE's
    // `{ 16.GB * task.attempt }` could escalate past the pool and become
    // unschedulable. Derived from the same env vars as the executor block so that
    // --cpus/--memory cannot silently leave every task capped at 16 cores.
    resourceLimits = [
        cpus:   (System.getenv('BENCH_EXECUTOR_CPUS') ?: '16') as int,
        memory: (System.getenv('BENCH_EXECUTOR_MEMORY') ?: '64.GB'),
    ]

    // Lightweight default: the ~118 single-threaded shell steps (stats, publishing,
    // BED concatenation, BAM-to-BED, merges). Measured median peak RSS 13 MB, p95 528 MB.
    cpus   = (System.getenv('BENCH_TASK_CPUS')   ?: '1') as int
    memory = ((System.getenv('BENCH_TASK_MEMORY') ?: '2') as int) + '.GB'

    // Measured 0.24 GB peak. The 4-core request is kept despite CUTADAPT_CLIP_RNASEQ
    // measuring only 1.27 cores: that shortfall is the single-threaded `gzip -c` in
    // the module's SE branch, so shrinking the reservation would improve the
    // efficiency column without making the step faster.
    withName: 'CUTADAPT_CLIP|CUTADAPT_CLIP_RNASEQ' {
        cpus   = 4
        memory = '2.GB'
    }

    // Matches the lightweight default, but declared explicitly because it is the
    // largest single consumer of total task time (1749 s, 14.0% at full depth -- more
    // than STAR_ALIGN) and must not be mistaken for an unsized process. Measured
    // 1.06 cores / 132 MB: correctly sized, and no reservation can improve it
    // (`umi_tools extract` is single-threaded and compresses through Python's gzip).
    withName: 'UMITOOLS_EXTRACT' {
        cpus   = 1
        memory = '2.GB'
    }

    // All four bowtie2 processes together: withName selectors are anchored, so a bare
    // `BOWTIE2_FILTER` would not match BOWTIE2_FILTER_RNASEQ or either
    // BOWTIE2_TRANSCRIPTOME*, and those would silently take the generic default.
    withName: 'BOWTIE2_FILTER|BOWTIE2_FILTER_RNASEQ|BOWTIE2_TRANSCRIPTOME|BOWTIE2_TRANSCRIPTOME_RNASEQ' {
        cpus   = 8
        memory = '8.GB'
    }

    // 48 GB covers the ~27 GB resident GRCh38 index plus the coordinate sort
    // (--limitBAMsortRAM derives as task.memory - 30 GiB, so 18 GiB here).
    // maxForks = 1: two concurrent STARs would each load the full index -- redundant
    // anyway, since 2 x 48 > 64 already serialises them on memory.
    //
    // 16 cpus / 48 GB is what the runs in results/gse269734 actually reserved. Note
    // that this block is NOT the one that decides it: benchmark.config declares the
    // same selector and lands last in the merged config, so it wins. See the note
    // there. The two are kept equal so the resolution order cannot change what is
    // measured; if you edit one, edit both (and references/human_server.yaml's
    // _bench block, which feeds BENCH_STAR_CPUS).
    //
    // Do NOT read this process's low p95_used_cores as evidence STAR cannot use its
    // threads: that column is a whole-TASK mean over index load + mapping + samtools +
    // gzip. The mapping phase alone ran at 392-956 M reads/hr.
    withName: 'STAR_ALIGN|STAR_ALIGN_RNASEQ' {
        cpus     = 16
        memory   = '48.GB'
        maxForks = 1
    }

    // 8 GB against a measured 4.34 GB peak, with the JVM heap capped to match --
    // reserve and cap together, or an unenforced reservation and an unbounded heap
    // can disagree. ext.algo = 'cc' carried over from conf/default.config:
    // '--algo dir' overflows the JVM stack on some hosts, and changing the algorithm
    // would change what is measured. No maxForks: 16 GB is left beside STAR's 48, so
    // the shipped profile admits two concurrent dedup tasks and the benchmark must too.
    withName: 'UMICOLLAPSE_DEDUP' {
        cpus         = 4
        memory       = { 8.GB * task.attempt }
        ext.algo     = 'cc'
        ext.jvm_opts = '-Xms512m -Xmx6g -Xss256m'
    }

    // The one genuine memory consumer besides STAR: with coverage: true and a 15-40 nt
    // read-length window it holds 26 per-length coverage arrays. Measured 8.83 GB peak,
    // so 16 GB is ~1.8x headroom and co-schedules with STAR (48 + 16 = 64 exactly).
    // Also the only ribopy process that consumes task.cpus (ribopy_create.nf: `-n
    // ${task.cpus}`); it measured 2.70 cores against 4.
    withName: 'RIBOPY_CREATE' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }

    // Measured 0.03 GB and 0.29 GB peak, and neither reads task.cpus. Split out from
    // RIBOPY_CREATE so two trivial processes do not each block a large slice of the
    // allocation from admission.
    withName: 'RIBOPY_MERGE|RIBOPY_RNASEQ_SET' {
        cpus   = 4
        memory = '4.GB'
    }

    // Mid-tier samtools + QC. `.*FASTQC`, not `FASTQC`: FASTQC is only ever included
    // under aliases, so a bare selector matches nothing. 8 GB is generous -- the
    // samtools members measured 0.01-0.04 GB -- but this layer exists to measure
    // conf/default.config, so it carries the profile's value. Change it there first.
    withName: 'SAMTOOLS_QPASS|SAMTOOLS_MERGE|SPLIT_STRANDED_BAM|SPLIT_DEDUP_BAM|RFC_EXTRACT_DEDUP_READS|.*FASTQC' {
        cpus   = 4
        memory = '8.GB'
    }

    // Inert in this benchmark (index is prebuilt, do_bigwig false,
    // star.output_transcriptome_bam false) but declared so this layer, not the
    // underlying profile, determines them. The `.*:` prefix is REQUIRED -- a qualified
    // selector must match the whole qualified name.
    withName: 'STAR_INDEX' {
        cpus     = 16
        memory   = '48.GB'
        maxForks = 1
    }
    withName: 'DEEPTOOLS_BAMCOVERAGE' {
        cpus   = 4
        memory = '8.GB'
    }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_QPASS'          { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SAMTOOLS_MERGE'          { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:SPLIT_DEDUP_BAM'         { cpus = 4; memory = '8.GB' }
    withName: '.*:STAR_TRANSCRIPTOME_DEDUP:RFC_EXTRACT_DEDUP_READS' { cpus = 4; memory = '8.GB' }

    // Implicit thread-pool cap for the Python/numpy processes that have no thread flag
    // of their own: `ribopy merge` and `ribopy rnaseq set` take no -n, and the stats
    // scripts are pandas, so OpenBLAS/OMP would size their pools from the host core
    // count (128 here) rather than from task.cpus.
    //
    // This is measurement instrumentation, not a performance fix -- the pools it caps
    // belong to sub-second tasks whose %cpu is a startup burst either way. It makes
    // p95_used_cores in efficiency.csv mean what it says. It lives in this benchmark
    // layer rather than in modules/local/*.nf so the pipeline under test stays
    // byte-identical to what is committed. beforeScript is a distinct directive, so it
    // composes with the cpus/memory selectors above instead of replacing them, and a
    // closure so task.cpus resolves per task.
    //
    // CAVEAT: verified for the ambient and conda profiles, where the task and the tool
    // share a shell. Under docker/apptainer, confirm the exports reach inside the
    // container first:  grep -h NUM_THREADS work/*/*/.command.{sh,run} | head
    withName: 'RIBOPY_.*|.*STATS_.*|.*COMBINE_.*' {
        beforeScript = {
            "export OMP_NUM_THREADS=${task.cpus} " +
            "OPENBLAS_NUM_THREADS=${task.cpus} " +
            "MKL_NUM_THREADS=${task.cpus} " +
            "NUMEXPR_NUM_THREADS=${task.cpus} " +
            "VECLIB_MAXIMUM_THREADS=${task.cpus}"
        }
    }
}
